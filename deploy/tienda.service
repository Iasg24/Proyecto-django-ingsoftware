# systemd — Servicio de la API (FastAPI + uvicorn)
# Se instala en /etc/systemd/system/tienda.service por deploy/setup.sh

[Unit]
Description=Tienda de Repuestos - API FastAPI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/tienda/backend-fastapi
ExecStart=/opt/tienda/backend-fastapi/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
