# Archivo de ejemplo: copia este archivo a .env y pega tus llaves de prueba
# de Stripe. Obtén las llaves en: stripe.com -> Dashboard -> Developers -> API keys
#
#   STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
#
# Importante: el archivo .env REAL no se sube a Git (está en .gitignore).
# Sin llaves, el pago con tarjeta usa la simulación local y todo funciona igual.
STRIPE_SECRET_KEY=
